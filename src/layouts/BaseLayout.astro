---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    reader?: boolean;
    home?: boolean;
    structured_data?: Record<string, unknown>;
}

const {
    title = "Joshua Sello | Electric Mobility and Transport Systems Researcher",
    description = "Joshua Sello is an electronic engineer and researcher studying electric minibus taxis, mobility data, transport networks, and sustainable infrastructure in South Africa.",
    reader = false,
    home = false,
    structured_data
} = Astro.props;

const canonical = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : Astro.url;

const structured_data_json = structured_data
    ? JSON.stringify(structured_data).replaceAll("<", "\\u003c")
    : undefined;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <link rel="icon" href="/icons/favicon.png" type="image/png" sizes="360x360" />
        <link rel="icon" href="/icons/favicon-32x32.png" type="image/png" sizes="32x32" />
        <link rel="icon" href="/icons/favicon-16x16.png" type="image/png" sizes="16x16" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#ffffff" />

        <meta property="og:type" content={reader ? "article" : "website"} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />

        {structured_data_json && (
            <script is:inline type="application/ld+json" set:html={structured_data_json} />
        )}

        <title>{title}</title>
    </head>
    <body
        class="min-h-screen bg-white font-serif text-sm leading-[1.55] text-neutral-900 antialiased [text-rendering:optimizeLegibility]"
    >
        {!home && <Header />}
        <main
            class:list={[
                {
                    "mx-auto w-[calc(100%-4rem)] max-w-2xl max-sm:w-[calc(100%-3rem)]": reader,
                    "mx-auto min-h-[calc(100vh-13rem)] w-[calc(100%-8rem)] max-w-6xl py-14 pb-32 max-lg:w-[calc(100%-4rem)] max-sm:w-[calc(100%-3rem)] max-sm:pt-8":
                        home
                }
            ]}
        >
            <slot />
        </main>
        <Footer />
    </body>
</html>
