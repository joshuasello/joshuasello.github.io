---
import type { Publication } from "../data/portfolio";

interface Props {
    items: Publication[];
}

const { items } = Astro.props;
---

<ol class="m-0 grid list-none p-0">
    {
        items.map((item) => (
            <li class="grid grid-cols-[8rem_minmax(0,1fr)] gap-6 border-t border-neutral-200 py-5 last:border-b max-sm:grid-cols-1 max-sm:gap-2.5">
                <div class="text-[0.72rem] text-neutral-400">{item.year}</div>
                <article>
                    <h3 class="m-0 text-[0.82rem] leading-[1.45] font-semibold">{item.title}</h3>
                    <p class="mt-1.5 text-[0.78rem] text-neutral-500">{item.authors}</p>
                    <div class="mt-1.5 text-[0.72rem] text-neutral-500 italic">{item.venue}</div>
                    {item.links.length > 0 && (
                        <div class="mt-2.5 flex flex-wrap gap-3 text-[0.7rem]">
                            {item.links.map((link) => (
                                <a
                                    class="underline decoration-neutral-400 underline-offset-2 transition-colors hover:text-neutral-500"
                                    href={link.url}
                                    target={link.url.startsWith("http") ? "_blank" : undefined}
                                    rel={link.url.startsWith("http") ? "noreferrer" : undefined}
                                >
                                    {link.label}
                                </a>
                            ))}
                        </div>
                    )}
                </article>
            </li>
        ))
    }
</ol>
