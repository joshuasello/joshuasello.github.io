---
const links = [
    // TODO: Add these links back in once the sections are ready
    // { href: "/#publications", label: "Publications" },
    // { href: "/#projects", label: "Projects" },
    { href: "/#writing", label: "Writing" }
];
---

<header class="border-b border-neutral-200">
    <nav
        class="mx-auto flex min-h-18 w-[calc(100%-4rem)] max-w-3xl items-center justify-between gap-8 max-sm:w-[calc(100%-3rem)] max-sm:flex-col max-sm:items-start max-sm:gap-3 max-sm:py-5"
        aria-label="Primary navigation"
    >
        <a class="text-[0.82rem] font-semibold no-underline transition-colors hover:text-neutral-500" href="/">
            Joshua Sello
        </a>
        <div class="flex flex-wrap gap-6 text-[0.72rem] text-neutral-500">
            {
                links.map((link) => (
                    <a class="no-underline transition-colors hover:text-neutral-900" href={link.href}>
                        {link.label}
                    </a>
                ))
            }
        </div>
    </nav>
</header>
