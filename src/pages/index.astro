---
import { getCollection } from "astro:content";
import ContentCard from "../components/ContentCard.astro";
import PublicationList from "../components/PublicationList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  preprints,
  publications,
  public_works,
  research,
  updates,
} from "../data/portfolio";
import { by_newest } from "../utils/content";

const articles = (
  await getCollection("articles", ({ data }) => !data.draft)
).sort(by_newest);

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort(by_newest);

const links = [
  { href: "/#research", label: "Research" },
  { href: "/#publications", label: "Publications" },
  { href: "/#public-works", label: "Public Works" },
  { href: "/#preprints", label: "Preprints" },
  // { href: "/#projects", label: "Projects" },
  // { href: "/#writing", label: "Writing" },
  { href: "/#updates", label: "Updates" },
];

const show_projects = projects.length > 0;
const show_articles = articles.length > 0;

const structured_data = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://joshuasello.com/#website",
      url: "https://joshuasello.com/",
      name: "Joshua Sello",
      inLanguage: "en",
    },
    {
      "@type": "ProfilePage",
      "@id": "https://joshuasello.com/#profile",
      url: "https://joshuasello.com/",
      name: "Joshua Sello | Electric Mobility and Transport Systems Researcher",
      isPartOf: {
        "@id": "https://joshuasello.com/#website",
      },
      mainEntity: {
        "@id": "https://joshuasello.com/#person",
      },
    },
    {
      "@type": "Person",
      "@id": "https://joshuasello.com/#person",
      name: "Joshua Sello",
      url: "https://joshuasello.com/",
      jobTitle: "Electronic Engineer and Researcher",
      description:
        "Electronic engineer and researcher studying electric minibus taxis, mobility data, transport networks, and sustainable infrastructure in South Africa.",
      affiliation: {
        "@type": "CollegeOrUniversity",
        name: "Stellenbosch University",
        url: "https://www.sun.ac.za/",
      },
      sameAs: [
        "https://linkedin.com/in/joshuasello",
        "https://github.com/joshuasello",
        "https://orcid.org/0009-0008-1263-3434",
      ],
      knowsAbout: [
        "Electric mobility",
        "Sustainable transport",
        "Mobility data",
        "Transport networks",
        "Energy-aware infrastructure",
        "Minibus-taxi electrification",
      ],
    },
  ],
};
---

<BaseLayout home structured_data={structured_data}>
  <div
    class="grid grid-cols-[11rem_minmax(0,1fr)] items-start gap-[clamp(4rem,8vw,7rem)] max-lg:grid-cols-1 max-lg:gap-16"
  >
    <aside
      class="sticky top-14 max-w-sm max-lg:static"
      id="contact"
      aria-labelledby="page-title"
    >
      <a class="block no-underline" href="/">
        <h1
          class="m-0 text-[0.95rem] leading-tight font-medium tracking-[0.025em]"
          id="page-title"
        >
          Joshua Sello
        </h1>
      </a>
      <div
        class="mt-6 grid gap-4 text-[0.78rem] leading-[1.65] text-neutral-700"
      >
        <p>
          I am an electronic engineer and researcher working on intelligent,
          efficient, and sustainable mobility systems.
        </p>
        <p>
          My interests span data-driven transport, energy-aware infrastructure,
          embedded intelligence, and practical tools for cleaner urban movement.
        </p>
      </div>
      <nav
        class="mt-5 grid gap-2 text-[0.72rem] text-neutral-500"
        aria-label="Profile links"
      >
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          <a
            class="underline decoration-neutral-400 underline-offset-2 hover:text-neutral-900"
            href="https://orcid.org/0009-0008-1263-3434"
            target="_blank"
            rel="noreferrer">ORCID</a
          >
          <a
            class="underline decoration-neutral-400 underline-offset-2 hover:text-neutral-900"
            href="https://ev.sun.ac.za/"
            target="_blank"
            rel="noreferrer">Electric Mobility Lab</a
          >
        </div>

        <div class="flex items-left gap-2">
          <a
            class="inline-flex size-7 items-center justify-center no-underline transition-colors hover:text-neutral-900"
            href="mailto:jtsello@sun.ac.za"
            aria-label="Email Joshua Sello"
            title="Email"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </a>
          <a
            class="inline-flex size-7 items-center justify-center no-underline transition-colors hover:text-neutral-900"
            href="https://linkedin.com/in/joshuasello"
            target="_blank"
            rel="noreferrer"
            aria-label="Joshua Sello on LinkedIn"
            title="LinkedIn"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"
              ></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            class="inline-flex size-7 items-center justify-center no-underline transition-colors hover:text-neutral-900"
            href="https://github.com/joshuasello"
            target="_blank"
            rel="noreferrer"
            aria-label="Joshua Sello on GitHub"
            title="GitHub"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.7-1.6 6.7-7A5.4 5.4 0 0 0 19.3 4a5 5 0 0 0-.1-3.4S18 0 15 2.3a13.4 13.4 0 0 0-7 0C5 0 3.8.6 3.8.6A5 5 0 0 0 3.7 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.4 6.6 6.7 7A4.8 4.8 0 0 0 8 18v4"
              ></path>
              <path d="M8 19c-3 .9-3-1.5-4-2"></path>
            </svg>
          </a>
        </div>
      </nav>
    </aside>

    <div class="min-w-0">
      <nav
        class="grid grid-cols-5 gap-x-10 gap-y-7 pb-22 max-lg:pb-18 max-sm:grid-cols-2 max-sm:gap-6"
        aria-label="Portfolio sections"
      >
        {
          links.map((link) => (
            <a
              class="text-[0.78rem] font-bold tracking-[0.025em] no-underline transition-colors hover:text-neutral-500"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Section: Research -->
      <section
        class="scroll-mt-8 border-t border-neutral-200 py-10 pb-22 max-sm:pb-16"
        id="research"
        aria-labelledby="research-title"
      >
        <div
          class="mb-10 grid grid-cols-[8rem_minmax(0,1fr)] gap-8 max-sm:mb-7 max-sm:grid-cols-1 max-sm:gap-2.5"
        >
          <h2
            class="m-0 text-[0.8rem] leading-tight font-bold tracking-[0.025em]"
            id="research-title"
          >
            Research
          </h2>
          <p class="max-w-lg text-[0.78rem] text-neutral-500">
            Current questions and technical areas that shape my work.
          </p>
        </div>
        <div class="grid">
          {
            research.map((item) => (
              <article class="grid grid-cols-[12rem_minmax(0,1fr)] gap-8 border-t border-neutral-200 py-5 last:border-b max-sm:grid-cols-1 max-sm:gap-2.5">
                <h3 class="m-0 text-[0.82rem] leading-[1.45] font-semibold">
                  {item.title}
                </h3>
                <p class="text-[0.78rem] text-neutral-500">
                  {item.description}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Section: Publications -->
      <section
        class="scroll-mt-8 border-t border-neutral-200 py-10 pb-22 max-sm:pb-16"
        id="publications"
        aria-labelledby="publications-title"
      >
        <div
          class="mb-10 grid grid-cols-[8rem_minmax(0,1fr)] gap-8 max-sm:mb-7 max-sm:grid-cols-1 max-sm:gap-2.5"
        >
          <h2
            class="m-0 text-[0.8rem] leading-tight font-bold tracking-[0.025em]"
            id="publications-title"
          >
            Publications
          </h2>
          <p class="max-w-lg text-[0.78rem] text-neutral-500">
            Peer-reviewed papers, conference proceedings, and technical reports.
          </p>
        </div>
        <PublicationList items={publications} />
      </section>

      <!-- Section: Public Works -->
      <section
        class="scroll-mt-8 border-t border-neutral-200 py-10 pb-22 max-sm:pb-16"
        id="public-works"
        aria-labelledby="public-works-title"
      >
        <div
          class="mb-10 grid grid-cols-[8rem_minmax(0,1fr)] gap-8 max-sm:mb-7 max-sm:grid-cols-1 max-sm:gap-2.5"
        >
          <h2
            class="m-0 text-[0.8rem] leading-tight font-bold tracking-[0.025em]"
            id="public-works-title"
          >
            Public Works
          </h2>
          <p class="max-w-lg text-[0.78rem] text-neutral-500">
            Public works and articles.
          </p>
        </div>
        <PublicationList items={public_works} />
      </section>

      <!-- Section: Preprints -->
      <section
        class="scroll-mt-8 border-t border-neutral-200 py-10 pb-22 max-sm:pb-16"
        id="preprints"
        aria-labelledby="preprints-title"
      >
        <div
          class="mb-10 grid grid-cols-[8rem_minmax(0,1fr)] gap-8 max-sm:mb-7 max-sm:grid-cols-1 max-sm:gap-2.5"
        >
          <h2
            class="m-0 text-[0.8rem] leading-tight font-bold tracking-[0.025em]"
            id="preprints-title"
          >
            Preprints
          </h2>
          <p class="max-w-lg text-[0.78rem] text-neutral-500">
            Public drafts, working papers, and work currently under review.
          </p>
        </div>
        <PublicationList items={preprints} />
      </section>

      <!-- Section: Projects -->
      {
        show_projects && (
          <section
            class="scroll-mt-8 border-t border-neutral-200 py-10 pb-22 max-sm:pb-16"
            id="projects"
            aria-labelledby="projects-title"
          >
            <div class="mb-10 grid grid-cols-[8rem_minmax(0,1fr)] gap-8 max-sm:mb-7 max-sm:grid-cols-1 max-sm:gap-2.5">
              <h2
                class="m-0 text-[0.8rem] leading-tight font-bold tracking-[0.025em]"
                id="projects-title"
              >
                Projects
              </h2>
              <p class="max-w-lg text-[0.78rem] text-neutral-500">
                Selected engineering and research projects, including methods,
                outcomes, and lessons learned.
              </p>
            </div>
            <div class="grid">
              {projects.map((entry) => (
                <ContentCard entry={entry} type="project" />
              ))}
            </div>
          </section>
        )
      }

      <!-- Section: Writing -->
      {
        show_articles && (
          <section
            class="scroll-mt-8 border-t border-neutral-200 py-10 pb-22 max-sm:pb-16"
            id="writing"
            aria-labelledby="writing-title"
          >
            <div class="mb-10 grid grid-cols-[8rem_minmax(0,1fr)] gap-8 max-sm:mb-7 max-sm:grid-cols-1 max-sm:gap-2.5">
              <h2
                class="m-0 text-[0.8rem] leading-tight font-bold tracking-[0.025em]"
                id="writing-title"
              >
                Writing
              </h2>
              <p class="max-w-lg text-[0.78rem] text-neutral-500">
                Technical explainers, field notes, and reflections from work in
                progress.
              </p>
            </div>
            <div class="grid">
              {articles.map((entry) => (
                <ContentCard entry={entry} type="article" />
              ))}
            </div>
          </section>
        )
      }

      <!-- Section: Updates -->
      <section
        class="scroll-mt-8 border-t border-neutral-200 pt-10"
        id="updates"
        aria-labelledby="updates-title"
      >
        <div
          class="mb-10 grid grid-cols-[8rem_minmax(0,1fr)] gap-8 max-sm:mb-7 max-sm:grid-cols-1 max-sm:gap-2.5"
        >
          <h2
            class="m-0 text-[0.8rem] leading-tight font-bold tracking-[0.025em]"
            id="updates-title"
          >
            Updates
          </h2>
          <p class="max-w-lg text-[0.78rem] text-neutral-500">
            Short notes on papers, talks, released work, and research
            milestones.
          </p>
        </div>
        <ol class="m-0 grid list-none p-0">
          {
            updates.map((item) => (
              <li class="grid grid-cols-[8rem_minmax(0,1fr)] gap-6 border-t border-neutral-200 py-4 last:border-b max-sm:grid-cols-1 max-sm:gap-2.5">
                <div class="text-[0.72rem] text-neutral-400">{item.date}</div>
                <p class="text-[0.78rem]">{item.text}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>
</BaseLayout>
